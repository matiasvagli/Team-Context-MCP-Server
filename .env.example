# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore — nunca lo commitees.
#
#   cp .env.example .env

# Token de GitHub para el scraper de debug memory.
#
# NO ES NECESARIO si tenés gh CLI autenticado (`gh auth login`).
# El scraper lo detecta automáticamente.
#
# Solo usá esto si no tenés gh CLI o querés usar un token diferente.
# Creá uno en: https://github.com/settings/tokens (scope: public_repo)
#
# Sin auth:  60 requests/hora
# Con auth: 5000 requests/hora
#
# GITHUB_TOKEN=

# (Opcional) Directorio donde se guardan las DBs.
# Default: ~/.team-mcp/
# TEAM_MCP_DB_DIR=/ruta/custom
